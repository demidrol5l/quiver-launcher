
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:QuiverLauncher.ViewModels"
             xmlns:services="using:QuiverLauncher.Services"
             xmlns:views="using:QuiverLauncher.Views"
             x:Class="QuiverLauncher.Views.BrowseView" x:DataType="vm:BrowseViewModel" x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="ComboBox.browse-filter">
            <!-- Короткие списки: все строки создаются сразу, поэтому полоса прокрутки точно учитывает весь список. -->
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeDarker}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
        </Style>
        <Style Selector="TextBlock.browse-section-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.4"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.browse-game-card">
            <Setter Property="Width" Value="340"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
        </Style>
        <Style Selector="Border.browse-game-card:pointerover">
            <Setter Property="BorderBrush" Value="#0ea5e9"/>
        </Style>
        <Style Selector="Border.browse-game-card.gamepad-focused">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <!-- На телефоне карточки занимают всю ширину, по одной в строке. -->
        <Style Selector="views|BrowseView.mobile Border.browse-game-card">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Карточка каталога; такие же карточки отображаются на странице игры. -->
        <DataTemplate x:Key="BrowseCardTemplate" x:DataType="vm:BrowseItem">
            <!-- Слот существует всегда для навигации с геймпада; карточка создаётся рядом с экраном. -->
            <Border Classes="browse-card-slot">
                <views:LazyCardContent Group="catalog" PlaceholderHeight="300">
                    <views:LazyCardContent.ContentTemplate>
                        <DataTemplate x:DataType="vm:BrowseItem">
                            <views:BrowseCard Tapped="BrowseCard_Tapped"/>
                        </DataTemplate>
                    </views:LazyCardContent.ContentTemplate>
                </views:LazyCardContent>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Surface"
          XYFocus.NavigationModes="Gamepad,Remote"
          XYFocus.UpNavigationStrategy="Projection"
          XYFocus.DownNavigationStrategy="Projection"
          XYFocus.LeftNavigationStrategy="Projection"
          XYFocus.RightNavigationStrategy="Projection"
          RowDefinitions="Auto,Auto,*">

        <!-- Заголовок и сортировка, затем поиск и фильтры. -->
        <Grid x:Name="BrowseToolbarPanel" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,30,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="BrowseTitleText" Text="Обзор каталога" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                <Border CornerRadius="5" Padding="7,2" VerticalAlignment="Center" BorderThickness="1"
                        Background="{DynamicResource ThemeLighter}" BorderBrush="{DynamicResource ThemeBorder}">
                    <TextBlock x:Name="BrowseCountText" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="BrowseSourceTabs" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="24,0,0,0"
                        VerticalAlignment="Center">
                <Button x:Name="BrowseCatalogTabButton" Classes="catalog-filter selected" Content="Каталог Quiver"
                        FontSize="11" MinHeight="32" Click="BrowseSourceTab_Click"/>
                <Button x:Name="BrowseCustomListTabButton" Classes="catalog-filter" Content="Мой список приложений"
                        FontSize="11" MinHeight="32" Click="BrowseSourceTab_Click"/>
            </StackPanel>

            <!-- Скрытие приложений из библиотеки располагается рядом с сортировкой, если хватает места. -->
            <StackPanel x:Name="BrowseSortPanel" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="BrowseSortLabel" Text="Сортировка" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                <TextBlock x:Name="BrowseRelevantText" Text="По релевантности ↓" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextSecondary}" IsVisible="False"/>
                <ComboBox x:Name="BrowseSortComboBox" Classes="browse-filter" MinWidth="150"
                          SelectionChanged="BrowseSort_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- Поиск и четыре фильтра. -->
        <Grid x:Name="BrowseFiltersPanel" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,0,30,14">
            <TextBox x:Name="BrowseSearchTextBox" Grid.Column="0"
                     Watermark="Поиск игр, проектов или тегов…"
                     MinHeight="40"
                     FontSize="12"
                     VerticalContentAlignment="Center"
                     Margin="0,0,18,0"
                     TextChanged="BrowseSearch_TextChanged">
                <TextBox.InnerLeftContent>
                    <Path Width="15" Height="15" Margin="12,0,2,0" Stretch="Uniform" VerticalAlignment="Center"
                          Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" StrokeLineCap="Round"
                          Data="M 11,4 A 7,7 0 1 1 10.99,4 Z M 16,16 L 21,21"/>
                </TextBox.InnerLeftContent>
            </TextBox>

            <Path x:Name="BrowseFiltersIcon" Grid.Column="1" Width="17" Height="17" Margin="0,0,10,0" Stretch="Uniform" VerticalAlignment="Center"
                  Stroke="{DynamicResource ThemeTextSecondary}" StrokeThickness="1.6" StrokeLineCap="Round"
                  Data="M 21,4 L 14,4 M 10,4 L 3,4 M 21,12 L 12,12 M 8,12 L 3,12 M 21,20 L 16,20 M 12,20 L 3,20 M 14,2 L 14,6 M 8,10 L 8,14 M 16,18 L 16,22"/>

            <Grid x:Name="BrowseFilterGrid" Grid.Column="2" ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10"
                  VerticalAlignment="Center">
                <ComboBox x:Name="BrowseTypeComboBox" Grid.Column="0" Classes="browse-filter" MinWidth="140"
                          ToolTip.Tip="Тип проекта" SelectionChanged="BrowseFilter_SelectionChanged"/>
                <ComboBox x:Name="BrowsePlatformComboBox" Grid.Column="1" Classes="browse-filter" MinWidth="130"
                          ToolTip.Tip="Операционная система" SelectionChanged="BrowseFilter_SelectionChanged"/>
                <ComboBox x:Name="BrowseConsoleComboBox" Grid.Column="2" Classes="browse-filter" MinWidth="180"
                          ToolTip.Tip="Консоль" SelectionChanged="BrowseFilter_SelectionChanged"/>
                <ComboBox x:Name="BrowseAiComboBox" Grid.Column="3" Classes="browse-filter" MinWidth="150"
                          ToolTip.Tip="Метки определяются по ответам разработчика, файлу README и данным репозитория"
                          SelectionChanged="BrowseFilter_SelectionChanged"/>
            </Grid>

            <WrapPanel x:Name="BrowseFilterSelects" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="BrowseHideLibraryCheckBox" Content="Скрыть приложения из моей библиотеки" FontSize="12" Margin="0,0,14,0"
                          VerticalAlignment="Center" Foreground="{DynamicResource ThemeText}"
                          ToolTip.Tip="Скрывает уже установленные приложения, чтобы было проще находить новые"
                          IsCheckedChanged="BrowseHideLibrary_Changed"/>
                <Button x:Name="BrowseRetryButton" Classes="options" Content="Повторить" FontSize="12" MinHeight="40"
                        Margin="0,0,10,0" IsVisible="False" Click="BrowseRetry_Click"/>
                <Button x:Name="BrowseClearFiltersButton" Classes="options" Content="Сбросить фильтры" FontSize="12" MinHeight="40"
                        Margin="0,0,10,0" IsVisible="False" Click="BrowseClearFilters_Click"/>
                <!-- Информация о результатах поиска, скрытых приложениях и недавно добавленных приложениях. -->
                <TextBlock x:Name="BrowseResultsText" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"
                           VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False"/>
            </WrapPanel>
        </Grid>

        <ScrollViewer x:Name="BrowseScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="BrowseScrollViewer_ScrollChanged">
            <StackPanel x:Name="BrowseContentStack" Margin="0,0,30,0">
                <StackPanel x:Name="BrowseLoadingPanel" Margin="0,8,0,0" Spacing="8" IsVisible="{Binding IsLoading}">
                    <ProgressBar Width="120" Height="4" HorizontalAlignment="Left" Minimum="0" Maximum="100"
                                 BorderThickness="0" Background="Transparent" IsIndeterminate="True"/>
                    <TextBlock Text="Загрузка приложений…" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </StackPanel>

                <!-- Игры, соответствующие запросу. -->
                <StackPanel x:Name="BrowseGamesSection" IsVisible="{Binding HasGames}" Margin="0,0,0,8">
                    <TextBlock Classes="browse-section-label" Text="ИГРЫ"/>
                    <ItemsControl x:Name="BrowseGamesControl" ItemsSource="{Binding Games}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BrowseGame">
                                <Border Classes="catalog-focus-card browse-game-card" Classes.gamepad-focused="{Binding IsGamepadFocused}"
                                        Cursor="Hand" Tapped="BrowseGame_Tapped">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="52" Height="52" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ThemeLighter}">
                                            <Image Stretch="UniformToFill" asyncImageLoader:ImageLoader.Source="{Binding Art}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding WaysText}" FontSize="12" Foreground="#7dd3fc"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="browse-section-label" Text="ПРИЛОЖЕНИЯ" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Карточки приложений. -->
                <ItemsControl x:Name="BrowseItemsControl" Classes="fill-cards" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:CardColumnsPanel MinColumnWidth="256" Spacing="14"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="BrowseCardTemplate"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="BrowseStatusText"
                           Text="{Binding Status}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,8"/>

                <TextBlock Text="Загрузка дополнительных приложений…" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}"
                           Margin="0,0,0,12" IsVisible="{Binding IsLoadingMore}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

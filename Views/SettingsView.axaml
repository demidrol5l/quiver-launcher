<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuiverLauncher.Views" xmlns:local="clr-namespace:QuiverLauncher"
             xmlns:vm="clr-namespace:QuiverLauncher.ViewModels"
             xmlns:services="clr-namespace:QuiverLauncher.Services"
             x:Class="QuiverLauncher.Views.SettingsView"
             x:DataType="vm:SettingsViewModel" x:CompileBindings="True">
<Border x:Name="SettingsSurface"
                                                XYFocus.NavigationModes="Gamepad,Remote"
                                                XYFocus.UpNavigationStrategy="Projection"
                                                XYFocus.DownNavigationStrategy="Projection"
                                                XYFocus.LeftNavigationStrategy="Projection"
                                                XYFocus.RightNavigationStrategy="Projection"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource ThemeDarker}"
                                                BorderBrush="{DynamicResource ThemeBorder}"
                                                BorderThickness="1,0,0,0"
                                                IsVisible="True"
                                                Opacity="0.97"
                                                ZIndex="10">
                                        <Grid x:Name="SettingsContent" RowDefinitions="Auto,*">

                                                        <!-- Settings Header -->
                                                        <Border Background="{DynamicResource ThemeBase}"
                                                                        Padding="20,14,20,14"
                                                                        BorderThickness="0,0,0,1"
                                                                        BorderBrush="{DynamicResource ThemeBorder}">
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                           Text="Настройки"
                                                                                           FontSize="20"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource ThemeText}"
                                                                                           VerticalAlignment="Center"/>
                                                                        <Button x:Name="CloseSettingsButton"
                                                                                        Grid.Column="1"
                                                                                        Classes="modern-icon"
                                                                                        Width="28"
                                                                                        Height="28"
                                                                                        ToolTip.Tip="Закрыть настройки"
                                                                                        Click="CloseSettingsPanel_Click">
                                                                                <Image Width="28"
                                                                                           Height="28"
                                                                                           Source="avares://QuiverLauncher/Assets/Icons/button_close.png"/>
                                                                        </Button>
                                                                </Grid>
                                                        </Border>

                                                        <!-- Tab Control -->
                                                        <TabControl Grid.Row="1" x:Name="SettingsTabControl"
                                                                                Background="Transparent"
                                                                                Foreground="{DynamicResource ThemeText}"
                                                                                Padding="4,4,4,0"
                                                                                Margin="0">
                                                                <TabControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                </TabControl.ItemsPanel>
                                                                <TabControl.Styles>
                                                                        <Style Selector="TabItem">
                                                                                <Setter Property="Theme">
                                                                                        <ControlTheme TargetType="TabItem">
                                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                                                <Setter Property="CornerRadius" Value="6"/>
                                                                                                <Setter Property="Padding" Value="8,4"/>
                                                                                                <Setter Property="Margin" Value="1,8,1,0"/>
                                                                                                <Setter Property="FontSize" Value="11"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                                <Setter Property="MinHeight" Value="36"/>
                                                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                                                <Setter Property="Template">
                                                                                                        <ControlTemplate TargetType="TabItem">
                                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                                                                                                Padding="{TemplateBinding Padding}">
                                                                                                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                                                                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                                                                </Border>
                                                                                                        </ControlTemplate>
                                                                                                </Setter>
                                                                                                <Style Selector="^:selected">
                                                                                                        <Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                                                </Style>
                                                                                                <Style Selector="^:pointerover">
                                                                                                        <Setter Property="Background" Value="{DynamicResource ThemeBase}"/>
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                                                </Style>
                                                                                                <Style Selector="^:selected:pointerover">
                                                                                                        <Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                                                </Style>
                                                                                                <Style Selector="^.gamepad-focused, ^:focus">
                                                                                                        <Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
                                                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                                                </Style>
                                                                                                <Style Selector="^:selected.gamepad-focused, ^:selected:focus">
                                                                                                        <Setter Property="Background" Value="{DynamicResource ThemeLighter}"/>
                                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeFocusRing}"/>
                                                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                                                </Style>
                                                                                        </ControlTheme>
                                                                                </Setter>
                                                                        </Style>
                                                                </TabControl.Styles>

                                                                <!-- General Tab -->
                                                                <TabItem Header="Общие"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <StackPanel Margin="16,12,16,16" Spacing="4">
                                        <Border IsVisible="{Binding HasAndroidUpdates}" Margin="0,0,0,12">
                                            <views:AndroidLauncherUpdateView DataContext="{Binding AndroidUpdates}"/>
                                        </Border>

                                                                                <!-- Behaviour -->
                                                                                <TextBlock Text="ПОВЕДЕНИЕ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>


                                                                                <StackPanel Spacing="2">
                                                                                        <CheckBox x:Name="CloseAfterLaunchCheckBox"
                                                                                                          Content="Закрывать после запуска"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding CloseAfterLaunch, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Автоматически закрывать лаунчер после запуска приложения"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding IsDesktopPlatform}">
                                                                                        <CheckBox x:Name="CloseToTrayCheckBox"
                                                                                                          Content="Сворачивать в системный трей"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding CloseToTray, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Оставлять Quiver Launcher работающим в области уведомлений после закрытия окна"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0" IsVisible="{Binding IsDesktopPlatform}">
                                                                                        <CheckBox x:Name="KioskModeCheckBox"
                                                                                                          Content="Режим киоска"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding KioskMode, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="При следующем запуске будет включён полноэкранный режим только для просмотра и запуска игр. Настройки, каталог и кнопки выхода будут скрыты. Нажмите Ctrl+Alt+K, чтобы разблокировать этот сеанс, и нажмите ещё раз, чтобы заблокировать его. Если задан ПИН-код, он требуется только для разблокировки. Для режима игрового автомата также следует назначить Quiver оболочкой Windows или запустить сеанс Linux Gamescope/cage, чтобы Alt+Tab и клавиша Windows не открывали рабочий стол."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                        <TextBox x:Name="KioskPinTextBox"
                                                                                                         PasswordChar="•"
                                                                                                         Watermark="ПИН-код (необязательно)"
                                                                                                         Margin="20,8,0,0"/>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,8,0,0">
                                                                                                <Button x:Name="SetKioskPinButton" Classes="options" Content="Установить ПИН-код" Click="SetKioskPin_Click"/>
                                                                                                <Button x:Name="ClearKioskPinButton" Classes="options" Content="Удалить ПИН-код"
                                                                                                                IsVisible="{Binding HasKioskPin}" Click="ClearKioskPin_Click"/>
                                                                                        </StackPanel>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0">
                                                                                        <CheckBox x:Name="IgnoreArticlesWhenSortingCheckBox"
                                                                                                          Content="Не учитывать The/A/An при сортировке по имени"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding IgnoreArticlesWhenSorting, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="При сортировке по алфавиту игнорировать The, A и An в начале названия (например, The Legend of Zelda будет в разделе L)"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                        <StackPanel Spacing="2" Margin="0,8,0,8" IsVisible="{Binding IsDesktopPlatform}">
                                            <TextBlock Text="Скорость прокрутки колёсиком мыши" FontSize="13" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="MouseWheelScrollSpeedComboBox" HorizontalAlignment="Stretch"
                                                      SelectedIndex="{Binding MouseWheelScrollSpeedIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Mouse wheel scroll speed">
                                                <ComboBoxItem Content="1×"/>
                                                <ComboBoxItem Content="2×"/>
                                                <ComboBoxItem Content="3×"/>
                                                <ComboBoxItem Content="5×"/>
                                            </ComboBox>
                                            <TextBlock Text="Величина прокрутки за один шаг колёсика в библиотеке и каталоге приложений."
                                                       FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <StackPanel Spacing="2" Margin="0,0,0,0">
                                                                                        <CheckBox x:Name="AutoUpdateNewlyAddedAppsCheckBox"
                                                                                                          Content="Включать автообновление для новых приложений"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding AutoUpdateNewlyAddedApps, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Для приложений, добавленных из каталога или вручную, автообновление будет включено"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0">
                                                                                        <CheckBox x:Name="BackgroundUpdateCheckCheckBox"
                                                                                                          Content="Проверять обновления приложений в фоновом режиме"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding BackgroundUpdateCheckEnabled, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Проверять обновления по расписанию, пока Quiver Launcher работает, в том числе в системном трее"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0">
                                                                                        <TextBlock Text="Интервал фоновой проверки"
                                                                                                           FontSize="13" FontWeight="SemiBold"
                                                                                                           Foreground="{DynamicResource ThemeText}"/>
                                                                                        <ComboBox x:Name="BackgroundUpdateIntervalComboBox"
                                                                                                          HorizontalAlignment="Stretch"
                                                                                                          Margin="0,4,0,0"
                                                                                                          SelectionChanged="BackgroundUpdateIntervalComboBox_SelectionChanged">
                                                                                                <ComboBoxItem Content="Каждые 15 минут" Tag="15"/>
                                                                                                <ComboBoxItem Content="Каждые 30 минут" Tag="30"/>
                                                                                                <ComboBoxItem Content="Каждый час" Tag="60"/>
                                                                                                <ComboBoxItem Content="Каждые 3 часа" Tag="180"/>
                                                                                                <ComboBoxItem Content="Каждые 6 часов" Tag="360"/>
                                                                                                <ComboBoxItem Content="Каждые 12 часов" Tag="720"/>
                                                                                                <ComboBoxItem Content="Каждый день" Tag="1440"/>
                                                                                        </ComboBox>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0">
                                                                                        <CheckBox x:Name="PromptAppUpdateReviewsCheckBox"
                                                                                                          Content="Уведомлять об обновлениях приложений в библиотеке"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding PromptAppUpdateReviews, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Автоматически показывать уведомления об обновлениях приложений. Ручная проверка по-прежнему отображает доступные обновления, а уведомления об обновлении самого Quiver Launcher продолжают появляться."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">

                                                                                        <!-- Divider -->
                                                                                        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                        <!-- Install Path -->
                                                                                        <TextBlock Text="ПУТЬ УСТАНОВКИ ПРИЛОЖЕНИЙ"
                                                                                                           FontSize="10" FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           LetterSpacing="1"
                                                                                                           Margin="0,0,0,4"/>

                                                                                        <TextBlock Text="Оставьте поле пустым, чтобы использовать расположение по умолчанию"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="0,0,0,4"/>

                                                                                        <Panel HorizontalAlignment="Stretch">
                                                                                                <TextBox x:Name="GamePathTextBox"
                                                                                                                 Foreground="{DynamicResource ThemeText}"
                                                                                                                 Background="{DynamicResource ThemeBase}"
                                                                                                                 BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                                 BorderThickness="1"
                                                                                                                 Padding="12,10"
                                                                                                                 CornerRadius="4"
                                                                                                                 Margin="0,0,44,0"
                                                                                                                 TextChanged="GamePathTextBox_TextChanged"
                                                                                                                 Text="{Binding Settings.AppsPath, Mode=OneWay}"/>
                                                                                                <Button Classes="options"
                                                                                                                HorizontalAlignment="Right"
                                                                                                                Width="40"
                                                                                                                Height="40"
                                                                                                                Content="📁"
                                                                                                                Click="BrowseGamePath_Click"/>
                                                                                        </Panel>

                                                                                        <Button Classes="options"
                                                                                                        Content="Сбросить по умолчанию"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        Click="ClearGamePath_Click"
                                                                                                        FontSize="12"/>

                                                                                        <!-- Data folder: only while it sits beside the AppImage / .app -->
                                                                                        <StackPanel x:Name="DataFolderPanel" Spacing="4" Margin="0,8,0,0" IsVisible="False">
                                                                                                <TextBlock Text="ПАПКА ДАННЫХ QUIVER"
                                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                                   LetterSpacing="1"
                                                                                                                   Margin="0,0,0,4"/>
                                                                                                <TextBlock x:Name="DataFolderText"
                                                                                                                   FontSize="11"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                                   TextWrapping="Wrap"
                                                                                                                   Margin="0,0,0,4"/>
                                                                                                <Button x:Name="MoveDataFolderButton"
                                                                                                                Classes="options"
                                                                                                                HorizontalAlignment="Stretch"
                                                                                                                Click="MoveDataToUserFolder_Click"
                                                                                                                FontSize="12"/>
                                                                                        </StackPanel>

                                                                                        <!-- Divider -->
                                                                                        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>
                                                                                </StackPanel>

                                                                                <!-- Platform & Cache -->
                                                                                <TextBlock Text="ПЛАТФОРМА И КЭШ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <TextBlock Text="{Binding PlatformString}"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <Button Classes="options"
                                                                                                Content="Изменить платформу"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Click="OptionsButton_Click"
                                                                                                Tag="{Binding}"
                                                                                                FontSize="12">
                                                                                        <Button.ContextMenu>
                                                                                                <ContextMenu>
                                                                                                        <MenuItem Header="Автоматически"   Click="PlatformAuto_Click"/>
                                                                                                        <MenuItem Header="Windows"     Click="PlatformWindows_Click"/>
                                                                                                        <MenuItem Header="MacOS"       Click="PlatformMacOS_Click"/>
                                                                                                        <MenuItem Header="Linux x64"   Click="PlatformLinuxX64_Click"/>
                                                                                                        <MenuItem Header="Linux ARM64" Click="PlatformLinuxARM64_Click"/>
                                                                                                        <MenuItem Header="Android"     Click="PlatformAndroid_Click"/>
                                                                                                </ContextMenu>
                                                                                        </Button.ContextMenu>
                                                                                </Button>

                                                                                <Button Classes="options"
                                                                                                Content="Очистить кэш значков"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Click="ClearIconCache_Click"
                                                                                                FontSize="12"/>

                                                                                <StackPanel Spacing="2" IsVisible="{Binding IsLinuxPlatform}">
                                                                                        <TextBlock Text="СРЕДА ЗАПУСКА WINDOWS В LINUX"
                                                                                                           FontSize="10" FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           LetterSpacing="1"
                                                                                                           Margin="0,8,0,4"/>
                                                                                        <TextBox x:Name="LinuxWindowsLaunchCommandTextBox"
                                                                                                         Foreground="{DynamicResource ThemeText}"
                                                                                                         Background="{DynamicResource ThemeBase}"
                                                                                                         BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                         BorderThickness="1"
                                                                                                         Padding="12,10"
                                                                                                         CornerRadius="4"
                                                                                                         Watermark="Например: flatpak run com.usebottles.bottles -e {exe}"
                                                                                                         Text="{Binding Settings.LinuxWindowsLaunchCommand, Mode=TwoWay}"
                                                                                                         TextChanged="LinuxWindowsLaunchCommandTextBox_TextChanged"/>
                                                                                        <TextBlock Text="Общая команда запуска Windows-приложений в Linux, когда выбран автоматический режим. Используйте {exe}, {gamePath} или {exeDir}. Среда запуска и префикс для отдельного приложения находятся в разделе «Параметры запуска → Среда запуска Windows». Оставьте поле пустым, чтобы автоматически определить Proton, а затем Wine."
                                                                                                           FontSize="11"
                                                                                                           TextWrapping="Wrap"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="0,0,0,4"/>
                                                                                </StackPanel>

                                                                                <!-- Anonymous usage data (PostHog) -->
                                                                                <StackPanel Spacing="2" IsVisible="{Binding UsageDataAvailable}">
                                                                                        <TextBlock Text="ДАННЫЕ ИСПОЛЬЗОВАНИЯ"
                                                                                                           FontSize="10" FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           LetterSpacing="1"
                                                                                                           Margin="0,8,0,4"/>
                                                                                        <CheckBox x:Name="UsageDataCheckBox"
                                                                                                          Content="Отправлять анонимные данные об использовании"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding UsageDataEnabled, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Помогает улучшать Quiver Launcher: собирает сведения об используемых функциях, установленных и запущенных приложениях и ошибках. Ваше имя, файлы и папки не передаются."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                        </StackPanel>
                                                                </ScrollViewer></TabItem>

                                                                <!-- Controls Tab -->
                                                                <TabItem Header="Управление" IsVisible="{Binding IsDesktopPlatform}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <views:InputBindingsView x:Name="BindingsView"/>
</ScrollViewer></TabItem>

                                                                <!-- Appearance Tab -->
                                                                <TabItem Header="Внешний вид"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <StackPanel Margin="16,12,16,16" Spacing="4">

                                                                                <StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
                                                                                        <!-- Window -->
                                                                                        <TextBlock Text="ОКНО"
                                                                                                           FontSize="10" FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           LetterSpacing="1"
                                                                                                           Margin="0,0,0,4"/>

                                                                                        <StackPanel Spacing="2" IsVisible="{Binding ShowStartFullscreenSetting}">
                                                                                                <CheckBox x:Name="StartFullscreenCheckBox"
                                                                                                                  Content="Запускать в полноэкранном режиме"
                                                                                                                  Foreground="{DynamicResource ThemeText}"
                                                                                                                  FontSize="13" FontWeight="SemiBold"
                                                                                                                  IsChecked="{Binding StartFullscreen, Mode=TwoWay}"/>
                                                                                                <TextBlock Text="Запускать приложение в полноэкранном режиме"
                                                                                                                   FontSize="11"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                                   Margin="20,0,0,0"/>
                                                                                        </StackPanel>

                                                                                        <StackPanel Spacing="2">
                                                                                                <CheckBox x:Name="ShowOSTopBarCheckBox"
                                                                                                                  Content="Показывать верхнюю системную панель"
                                                                                                                  Foreground="{DynamicResource ThemeText}"
                                                                                                                  FontSize="13" FontWeight="SemiBold"
                                                                                                                  IsChecked="{Binding ShowOSTopBar, Mode=TwoWay}"/>
                                                                                                <TextBlock Text="Показывать строку заголовка окна операционной системы"
                                                                                                                   FontSize="11"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                                   Margin="20,0,0,0"/>
                                                                                        </StackPanel>

                                                                                        <StackPanel Spacing="2" IsVisible="{Binding ShowOSTopBar}">
                                                                                                <CheckBox x:Name="HideWindowControlsCheckBox"
                                                                                                                  Content="Скрыть кнопки управления окном Quiver"
                                                                                                                  Foreground="{DynamicResource ThemeText}"
                                                                                                                  FontSize="13" FontWeight="SemiBold"
                                                                                                                  IsChecked="{Binding HideWindowControls, Mode=TwoWay}"/>
                                                                                                <TextBlock Text="Использовать системную панель для сворачивания, разворачивания и закрытия окна"
                                                                                                                   FontSize="11" TextWrapping="Wrap"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                                   Margin="20,0,0,0"/>
                                                                                        </StackPanel>

                                                                                        <StackPanel Spacing="4" Margin="0,8,0,0">
                                                                                                <TextBlock Text="Масштаб интерфейса" FontSize="13" FontWeight="SemiBold"/>
                                                                                                <ComboBox x:Name="InterfaceScaleComboBox" MinWidth="120" FontSize="13"
                                                                                                        HorizontalAlignment="Left" Focusable="True"
                                                                                                        AutomationProperties.Name="Interface scale"
                                                                                                        SelectedIndex="{Binding InterfaceScaleIndex, Mode=TwoWay}">
                                                                                                        <ComboBoxItem Content="50%"/>
                                                                                                        <ComboBoxItem Content="75%"/>
                                                                                                        <ComboBoxItem Content="100%"/>
                                                                                                        <ComboBoxItem Content="125%"/>
                                                                                                        <ComboBoxItem Content="150%"/>
                                                                                                        <ComboBoxItem Content="175%"/>
                                                                                                        <ComboBoxItem Content="200%"/>
                                                                                                        <ComboBoxItem Content="225%"/>
                                                                                                </ComboBox>
                                                                                                <TextBlock Text="Изменить размер текста и элементов управления Quiver. Применяется сразу."
                                                                                                        TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                                <TextBlock Text="{Binding InterfaceScaleNotice}" IsVisible="{Binding ShowInterfaceScaleNotice}"
                                                                                                        TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <!-- Divider -->
                                                                                        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>
                                                                                </StackPanel>

                                                                                <!-- Theme Colors -->
                                                                                <TextBlock Text="ЦВЕТА ТЕМЫ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <Button Classes="options"
                                                                                                Content="Основной цвет"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Click="ThemeColorPicker_Click"
                                                                                                FontSize="12"/>
                                                                                <Button Classes="options"
                                                                                                Content="Дополнительный цвет"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Click="SecondaryColorPicker_Click"
                                                                                                FontSize="12"/>
                                                                                <TextBlock Text="Цвет текста"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                   Margin="0,4,0,0"/>
                                                                                <ComboBox x:Name="ThemeTextModeComboBox"
                                                                                                  HorizontalAlignment="Stretch"
                                                                                                  SelectedIndex="{Binding ThemeTextModeIndex, Mode=TwoWay}">
                                                                                                <ComboBoxItem Content="Автоматически"/>
                                                                                                <ComboBoxItem Content="Светлый текст"/>
                                                                                                <ComboBoxItem Content="Тёмный текст"/>
                                                                                        </ComboBox>
                                                                                <TextBlock Text="Выберите светлый или тёмный текст, если пользовательские цвета темы ухудшают читаемость."
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   TextWrapping="Wrap"/>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <!-- Background Image -->
                                                                                <TextBlock Text="ФОНОВОЕ ИЗОБРАЖЕНИЕ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <TextBlock Text="Поддерживаются форматы PNG, JPG и GIF"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <Button Classes="options"
                                                                                                Content="Выбрать изображение"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Click="SelectBackgroundImage_Click"
                                                                                                FontSize="12"/>
                                                                                <Button Classes="options"
                                                                                                Content="Убрать фон"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Click="ClearBackgroundImage_Click"
                                                                                                IsEnabled="{Binding BackgroundImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                                                FontSize="12"/>

                                                                                <StackPanel Spacing="4" Margin="0,4,0,0">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Непрозрачность:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding ElementName=BackgroundOpacitySlider, Path=Value, StringFormat={}{0:F2}}"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="BackgroundOpacitySlider"
                                                                                                        Minimum="0" Maximum="1"
                                                                                                        Value="{Binding BackgroundOpacity}"
                                                                                                        TickFrequency="0.01"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="4" IsVisible="{Binding IsDesktopPlatform}">
                                                                                        <!-- Divider -->
                                                                                        <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                        <!-- Background Music -->
                                                                                        <TextBlock Text="ФОНОВАЯ МУЗЫКА"
                                                                                                           FontSize="10" FontWeight="Bold"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           LetterSpacing="1"
                                                                                                           Margin="0,0,0,4"/>

                                                                                        <TextBlock Text="Поддерживаются форматы MP3, WAV и OGG"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="0,0,0,4"/>

                                                                                        <Button Classes="options"
                                                                                                        Content="Выбрать музыку"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        Click="SelectLauncherMusic_Click"
                                                                                                        FontSize="12"/>
                                                                                        <Button Classes="options"
                                                                                                        Content="Убрать музыку"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        Click="ClearLauncherMusic_Click"
                                                                                                        IsEnabled="{Binding LauncherMusicPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                                                        FontSize="12"/>

                                                                                        <StackPanel Spacing="4" Margin="0,4,0,0">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                        <TextBlock Text="Громкость:"
                                                                                                                           FontSize="12"
                                                                                                                           Foreground="{DynamicResource ThemeText}"
                                                                                                                           VerticalAlignment="Center"/>
                                                                                                        <TextBlock Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:F2}}"
                                                                                                                           FontSize="12"
                                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                                </StackPanel>
                                                                                                <Slider x:Name="MusicVolumeSlider"
                                                                                                                Minimum="0" Maximum="1"
                                                                                                                Value="{Binding MusicVolume}"
                                                                                                                TickFrequency="0.01"
                                                                                                                IsSnapToTickEnabled="True"
                                                                                                                ValueChanged="MusicVolumeSlider_ValueChanged"/>
                                                                                        </StackPanel>
                                                                                </StackPanel>

                                                                        </StackPanel>
                                                                </ScrollViewer></TabItem>

                                                                <!-- App Cards Tab -->
                                                                <TabItem Header="Карточки приложений"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <StackPanel Margin="16,12,16,16" Spacing="4">

                                                                                <!-- Layout -->
                                                                                <TextBlock Text="РАСПОЛОЖЕНИЕ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <StackPanel Spacing="2">
                                                                                        <CheckBox x:Name="UseGridViewCheckBox"
                                                                                                          Content="Вид сеткой"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding UseGridView, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Отображать приложения сеткой вместо списка"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,4,0,0">
                                                                                        <CheckBox x:Name="GridCompactCardsCheckBox"
                                                                                                          Content="Подробности в карточке"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsEnabled="{Binding ElementName=UseGridViewCheckBox, Path=IsChecked}"
                                                                                                          IsChecked="{Binding GridCompactCards, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Показывать название, статус и кнопки внутри каждой карточки"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                                                                        <TextBlock Text="Предустановки"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <Button Classes="modern-icon" Width="52" Height="52"
                                                                                                                Click="LayoutPreset_Landscape_Click"
                                                                                                                ToolTip.Tip="Альбомная ориентация">
                                                                                                        <Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_landscape.png"/>
                                                                                                </Button>
                                                                                                <Button Classes="modern-icon" Width="52" Height="52"
                                                                                                                Click="LayoutPreset_Square_Click"
                                                                                                                ToolTip.Tip="Квадрат">
                                                                                                        <Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square.png"/>
                                                                                                </Button>
                                                                                                <Button Classes="modern-icon" Width="52" Height="52"
                                                                                                                Click="LayoutPreset_SquareAlt_Click"
                                                                                                                ToolTip.Tip="Квадратный вариант">
                                                                                                        <Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_square_alt.png"/>
                                                                                                </Button>
                                                                                                <Button Classes="modern-icon" Width="52" Height="52"
                                                                                                                Click="LayoutPreset_Portrait_Click"
                                                                                                                ToolTip.Tip="Портретная ориентация">
                                                                                                        <Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_portrait.png"/>
                                                                                                </Button>
                                                                                                <Button Classes="modern-icon" Width="52" Height="52"
                                                                                                                Click="LayoutPreset_List_Click"
                                                                                                                ToolTip.Tip="Список">
                                                                                                        <Image Width="52" Height="52" Source="avares://QuiverLauncher/Assets/Icons/preset_list.png"/>
                                                                                                </Button>
                                                                                        </StackPanel>
                                                                                </StackPanel>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <!-- Card Content -->
                                                                                <TextBlock Text="СОДЕРЖИМОЕ КАРТОЧЕК"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <StackPanel Spacing="2" Margin="0,0,0,0">
                                                                                        <TextBlock Text="Отображение названий в библиотеке"
                                                                                                           FontSize="13"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Foreground="{DynamicResource ThemeText}"/>
                                                                                        <ComboBox x:Name="LibraryNameStyleComboBox"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          Background="{DynamicResource ThemeBase}"
                                                                                                          BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                          BorderThickness="1"
                                                                                                          CornerRadius="4"
                                                                                                          Padding="8"
                                                                                                          Margin="0,4,0,0"
                                                                                                          SelectionChanged="LibraryNameStyleComboBox_SelectionChanged">
                                                                                                <ComboBoxItem Content="Только название" Tag="NameOnly"/>
                                                                                                <ComboBoxItem Content="Название и проект ниже" Tag="NameAndProject"/>
                                                                                                <ComboBoxItem Content="Проект и название ниже (как в каталоге приложений)" Tag="ProjectAndName"/>
                                                                                                <ComboBoxItem Content="Название (проект) в заголовке" Tag="NameAndProjectInTitle"/>
                                                                                                <ComboBoxItem Content="Только проект" Tag="ProjectOnly"/>
                                                                                        </ComboBox>
                                                                                        <TextBlock Text="Как отображаются названия и проекты в библиотеке. В варианте «ниже» дополнительная строка показывается под заголовком серым цветом. Если задано пользовательское отображаемое имя, оно всегда имеет приоритет."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0">
                                                                                        <CheckBox x:Name="TruncateLibraryCardTitlesCheckBox"
                                                                                                          Content="Сокращать названия, проекты и версии в карточках библиотеки"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding TruncateLibraryCardTitles, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Когда карточка не активна, текст сокращается многоточием. При наведении или фокусе с геймпада/клавиатуры отображаются полные название, проект и версия."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <StackPanel Spacing="2" Margin="0,8,0,0">
                                                                                        <TextBlock Text="Количество строк тегов в карточках библиотеки"
                                                                                                           FontSize="13"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Foreground="{DynamicResource ThemeText}"/>
                                                                                        <ComboBox x:Name="LibraryCardTagMaxLinesComboBox"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          Background="{DynamicResource ThemeBase}"
                                                                                                          BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                          BorderThickness="1"
                                                                                                          CornerRadius="4"
                                                                                                          Padding="8"
                                                                                                          Margin="0,4,0,0"
                                                                                                          SelectionChanged="LibraryCardTagMaxLinesComboBox_SelectionChanged">
                                                                                                <ComboBoxItem Content="0 строк" Tag="0"/>
                                                                                                <ComboBoxItem Content="1 строка" Tag="1"/>
                                                                                                <ComboBoxItem Content="2 строки" Tag="2"/>
                                                                                                <ComboBoxItem Content="3 строки" Tag="3"/>
                                                                                                <ComboBoxItem Content="4 строки" Tag="4"/>
                                                                                                <ComboBoxItem Content="Без ограничений" Tag="99"/>
                                                                                        </ComboBox>
                                                                                        <TextBlock Text="Количество строк тегов, отображаемых в карточке библиотеки. Значение 0 скрывает теги в карточках, но фильтры продолжают работать."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <!-- Card Size -->
                                                                                <TextBlock Text="{Binding CardSizeLabel}"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <StackPanel Spacing="4">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Размер:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding DisplayCardSize, StringFormat={}{0:0}}"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="ListRowHeightSlider" Minimum="72" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" IsVisible="{Binding !UseGridView}" Value="{Binding ListRowHeight, Mode=TwoWay}"/>
<Slider x:Name="SlotSizeSlider"
                                                                                                        Minimum="120" Maximum="400" IsVisible="{Binding UseGridView}"
                                                                                                        TickFrequency="4"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        Value="{Binding SlotSize, Mode=TwoWay}"/>
                                                                                </StackPanel>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <!-- Action Buttons -->
                                                                                <TextBlock Text="КНОПКИ ДЕЙСТВИЙ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <StackPanel Spacing="4">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Размер:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding ElementName=ActionButtonSizeSlider, Path=Value, StringFormat={}{0:0}}"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="ActionButtonSizeSlider"
                                                                                                        Minimum="32" Maximum="80"
                                                                                                        TickFrequency="4"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        Value="{Binding ActionButtonSize, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Размер кнопок «Играть», «Скачать» и «Обновить»"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                </StackPanel>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <!-- App Images -->
                                                                                <TextBlock Text="ИЗОБРАЖЕНИЯ ИГР"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <!-- Size -->
                                                                                <StackPanel Spacing="4">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Размер:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0}}"
                                                                                                                   FontSize="11"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="IconSizeSlider"
                                                                                                        Minimum="64" Maximum="512"
                                                                                                        TickFrequency="4"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        Value="{Binding IconSize, Mode=TwoWay}"/>
                                                                                </StackPanel>

                                                                                <!-- Custom Image Fill -->
                                                                                <StackPanel Spacing="2">
                                                                                        <CheckBox x:Name="IconFillCheckBox"
                                                                                                          Content="Заполнять карточки"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding IconFill, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="{Binding ImageFillDescription}"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"/>
                                                                                </StackPanel>

                                                                                <!-- Image Opacity -->
                                                                                <StackPanel Spacing="4">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Непрозрачность изображения карточки:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding ElementName=IconOpacitySlider, Path=Value, StringFormat={}{0:F1}}"
                                                                                                                   FontSize="11"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="IconOpacitySlider"
                                                                                                        Minimum="0.0" Maximum="1.0"
                                                                                                        TickFrequency="0.1"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        Value="{Binding IconOpacity, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Настроить прозрачность изображения"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                </StackPanel>

                                                                                <!-- Left Padding -->
                                                                                <StackPanel Spacing="4" IsVisible="{Binding UseGridView}">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Отступ слева:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding ElementName=IconMarginSlider, Path=Value, StringFormat={}{0:0}}"
                                                                                                                   FontSize="11"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="IconMarginSlider"
                                                                                                        Minimum="0" Maximum="512"
                                                                                                        TickFrequency="8"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        Value="{Binding IconMargin, Mode=TwoWay}"/>
                                                                                </StackPanel>

                                                                                <!-- Divider -->
                                                                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,8"/>

                                                                                <!-- Text -->
                                                                                <TextBlock Text="ТЕКСТ" IsVisible="{Binding UseGridView}"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <StackPanel Spacing="4" IsVisible="{Binding UseGridView}">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="Отступ текста:"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeText}"
                                                                                                                   VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding ElementName=TextMarginSlider, Path=Value, StringFormat={}{0:0}}"
                                                                                                                   FontSize="12"
                                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                        </StackPanel>
                                                                                        <Slider x:Name="TextMarginSlider"
                                                                                                        Minimum="0" Maximum="256"
                                                                                                        TickFrequency="8"
                                                                                                        IsSnapToTickEnabled="True"
                                                                                                        Value="{Binding SlotTextMargin, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Настроить левый отступ текстовых подписей"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                                                </StackPanel>

                                                                        </StackPanel>
                                                                </ScrollViewer></TabItem>

                                                                <!-- Advanced Tab -->
                                                                <TabItem Header="Дополнительно"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                        <StackPanel Margin="16,12,16,16" Spacing="4">

                                                                                <!-- GitHub API Token -->
                                                                                <TextBlock Text="ТОКЕН GITHUB API"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <TextBlock Text="Повышает лимиты API для более быстрой и надёжной загрузки"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Margin="0,0,0,6"/>
                                                                                <TextBlock x:Name="GitHubRateLimitText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,6"/>

                                                                                <TextBox x:Name="GitHubTokenTextBox"
                                                                                                 Foreground="{DynamicResource ThemeText}"
                                                                                                 Background="{DynamicResource ThemeBase}"
                                                                                                 BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                 BorderThickness="1"
                                                                                                 Padding="12,10"
                                                                                                 CornerRadius="4"
                                                                                                 TextChanged="GitHubTokenTextBox_TextChanged"
                                                                                                 PasswordChar="●"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0"><Button x:Name="SaveGitHubTokenButton" Grid.Column="0" Classes="options" Content="Сохранить токен" MinHeight="44" HorizontalAlignment="Stretch" Click="SaveGitHubToken_Click" FontSize="12"/><Button  Grid.Column="1" Classes="options" Content="Удалить токен" MinHeight="44" HorizontalAlignment="Stretch" Click="ClearGitHubToken_Click" FontSize="12"/></Grid>
<TextBlock Text="Сохраните токен, чтобы применить его и возобновить ожидающие проверки." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button  Grid.Column="0" Classes="options" Content="Создать токен" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="CreateGitHubToken_Click" FontSize="12"/><Button x:Name="GitHubTokenHelpButton" Grid.Column="1" Classes="options" Content="Инструкция по настройке" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="GitHubTokenHelp_Click" FontSize="12"/></Grid><StackPanel x:Name="GitHubTokenHelpText" IsVisible="False" Spacing="6" Margin="0,8,0,8"><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.Introduction}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.CreateStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.ExpirationStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.PermissionsStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.GenerateStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.SaveStep}"/><TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Text="{x:Static services:GitHubTokenSetupGuide.Privacy}"/></StackPanel>
<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

                                                                                <!-- GitLab API Token -->
                                                                                <TextBlock Text="ТОКЕН GITLAB API"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>

                                                                                <TextBlock Text="Необязательно. Повышает лимиты GitLab API и позволяет работать с закрытыми проектами на gitlab.com"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Margin="0,0,0,6"/>

                                                                                <TextBox x:Name="GitLabTokenTextBox"
                                                                                                 Foreground="{DynamicResource ThemeText}"
                                                                                                 Background="{DynamicResource ThemeBase}"
                                                                                                 BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                 BorderThickness="1"
                                                                                                 Padding="12,10"
                                                                                                 CornerRadius="4"
                                                                                                 TextChanged="GitLabTokenTextBox_TextChanged"
                                                                                                 PasswordChar="●"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0"><Button x:Name="SaveGitLabTokenButton" Grid.Column="0" Classes="options" Content="Сохранить токен" MinHeight="44" HorizontalAlignment="Stretch" Click="SaveGitLabToken_Click" FontSize="12"/><Button  Grid.Column="1" Classes="options" Content="Удалить токен" MinHeight="44" HorizontalAlignment="Stretch" Click="ClearGitLabToken_Click" FontSize="12"/></Grid>
<TextBlock Text="Сохраните токен, чтобы применить его и возобновить ожидающие проверки." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
<Button  Grid.Column="0" Classes="options" Content="Создать токен" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="CreateGitLabToken_Click" FontSize="12"/><TextBlock Text="Для доступа к релизам выберите разрешение read_api." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0"/>
<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

                                                                                <!-- Codeberg API Token -->
                                                                                <TextBlock Text="ТОКЕН CODEBERG API" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" LetterSpacing="1" Margin="0,0,0,4"/>
                                                                                <TextBlock Text="Необязательно. Позволяет работать с закрытыми проектами на codeberg.org." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                                                <TextBox x:Name="CodebergTokenTextBox" Foreground="{DynamicResource ThemeText}" Background="{DynamicResource ThemeBase}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="12,10" CornerRadius="4" TextChanged="CodebergTokenTextBox_TextChanged" PasswordChar="●"/>
<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0"><Button x:Name="SaveCodebergTokenButton" Grid.Column="0" Classes="options" Content="Сохранить токен" MinHeight="44" HorizontalAlignment="Stretch" Click="SaveCodebergToken_Click" FontSize="12"/><Button Grid.Column="1" Classes="options" Content="Удалить токен" MinHeight="44" HorizontalAlignment="Stretch" Click="ClearCodebergToken_Click" FontSize="12"/></Grid>
<TextBlock Text="Сохраните токен, чтобы применить его и возобновить ожидающие проверки." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8"/>
<Button Classes="options" Content="Создать токен" MinHeight="32" Padding="10,4" HorizontalAlignment="Stretch" Click="CreateCodebergToken_Click" FontSize="12"/><TextBlock Text="Выберите разрешения: repository — чтение, user — чтение." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0"/>
<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

                                                                                <!-- The player's own app list -->
                                                                                <TextBlock Text="МОЙ СПИСОК ПРИЛОЖЕНИЙ"
                                                                                                   FontSize="10" FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   LetterSpacing="1"
                                                                                                   Margin="0,0,0,4"/>
                                                                                <TextBlock Text="Необязательно. JSON-файл или ссылка (например, прямая ссылка GitHub) в формате apps.json. Приложения из него отображаются в разделе «Мой список приложений» каталога."
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   Margin="0,0,0,6"/>
                                                                                <TextBox x:Name="CustomAppListTextBox"
                                                                                                 Watermark="Ссылка или путь к файлу"
                                                                                                 Foreground="{DynamicResource ThemeText}"
                                                                                                 Background="{DynamicResource ThemeBase}"
                                                                                                 BorderBrush="{DynamicResource ThemeBorder}"
                                                                                                 BorderThickness="1"
                                                                                                 Padding="12,10"
                                                                                                 CornerRadius="4"/>
<Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0"><Button Grid.Column="0" Classes="options" Content="Сохранить список" MinHeight="44" HorizontalAlignment="Stretch" Click="SaveCustomAppList_Click" FontSize="12"/><Button Grid.Column="1" Classes="options" Content="Выбрать файл" MinHeight="44" HorizontalAlignment="Stretch" Click="BrowseCustomAppList_Click" FontSize="12" IsVisible="{x:Static services:PlatformCapabilities.IsDesktop}"/><Button Grid.Column="2" Classes="options" Content="Очистить" MinHeight="44" HorizontalAlignment="Stretch" Click="ClearCustomAppList_Click" FontSize="12"/></Grid>
<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,12,0,8"/>

                                                                                <StackPanel Spacing="2">
                                                                                        <CheckBox x:Name="AllowPrereleaseLauncherUpdatesCheckBox"
                                                                                                          Content="Включать предварительные обновления"
                                                                                                          Foreground="{DynamicResource ThemeText}"
                                                                                                          FontSize="13" FontWeight="SemiBold"
                                                                                                          IsChecked="{Binding AllowPrereleaseLauncherUpdates, Mode=TwoWay}"/>
                                                                                        <TextBlock Text="Получать предварительные версии Quiver Launcher раньше остальных. Они могут работать нестабильно."
                                                                                                           FontSize="11"
                                                                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                                                                           Margin="20,0,0,0"
                                                                                                           TextWrapping="Wrap"/>
                                                                                </StackPanel>

                                                                        </StackPanel>
                                                                </ScrollViewer></TabItem>

                                                        </TabControl>
                                        </Grid>
                                </Border>
</UserControl>